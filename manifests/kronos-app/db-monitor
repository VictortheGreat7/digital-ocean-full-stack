apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: postgres-monitor
  namespace: kronos
  labels:
    app: kronos-app
    component: db
    environment: development
spec:
  selector:
    matchLabels:
      app: kronos-app
      component: db
      environment: development
  endpoints:
    - port: metrics
      interval: 30s
      path: /metrics
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: pgbouncer-monitor
  namespace: kronos
  labels:
    app: kronos-app
    component: pgbouncer
    environment: development
spec:
  selector:
    matchLabels:
      app: kronos-app
      component: pgbouncer
      environment: development
  endpoints:
    - port: metrics
      interval: 30s
      path: /metrics